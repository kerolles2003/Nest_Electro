+  border: 1px solid var(--color-border);
+  border-radius: 3px;
+}
+.admin-user-trigger {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  padding-left: 12px;
+  border-left: 1px solid var(--color-border);
+  font-size: 12px;
+}
+.admin-user-name {
+  max-width: 130px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.admin-mobile-nav-trigger {
+  display: none;
+}
+.admin-app .admin-nav-dialog {
+  --tw-translate-x: 0;
+  --tw-translate-y: 0;
+  translate: 0 0;
+  position: fixed;
+  top: 0;
+  left: 0;
+  transform: none;
+  height: 100dvh;
+  max-height: 100dvh;
+  width: min(280px, calc(100vw - 32px));
+  max-width: none;
+  border-radius: 0;
+  background: #efefe7;
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+  padding: 0;
 }
-.scrollbar-thin::-webkit-scrollbar-thumb:hover {
-  background: var(--color-border-strong);
+@media (max-width: 1279px) {
+  .admin-user-name {
+    display: none;
+  }
+}
+@media (max-width: 1023px) {
+  .admin-sidebar {
+    display: none;
+  }
+  .admin-mobile-nav-trigger {
+    display: flex;
+    position: fixed;
+    top: 14px;
+    left: 13px;
+    z-index: 25;
+  }
+  .admin-topbar {
+    padding: 0 20px 0 64px;
+  }
+  .admin-breadcrumb {
+    display: none;
+  }
+  .admin-topbar-tools {
+    flex: 1;
+  }
+  .admin-global-search {
+    margin-right: auto;
+  }
+}
+@media (max-width: 639px) {
+  .admin-topbar {
+    height: 64px;
+    padding-right: 12px;
+    gap: 8px;
+  }
+  .admin-topbar-tools {
+    gap: 5px;
+  }
+  .admin-global-search {
+    flex: 1;
+    width: 0;
+  }
+  .admin-global-search input {
+    width: 100%;
+    font-size: 14px;
+  }
+  .admin-global-search kbd,
+  .admin-global-search > svg {
+    display: none;
+  }
+  .admin-user-trigger {
+    padding-left: 5px;
+  }
+  .admin-user-trigger > svg {
+    display: none;
+  }
+  .admin-app .admin-nav-label {
+    min-height: 30px;
+  }
+  .admin-nav-item {
+    min-height: 42px;
+  }
+}
+
+@media (max-width: 479px) {
+  .admin-stats {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .admin-stat {
+    padding: 18px;
+  }
+  .admin-stat-value {
+    font-size: 28px;
+    margin: 10px 0;
+  }
 }
